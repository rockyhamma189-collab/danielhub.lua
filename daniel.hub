local function CreateControlModule(name, desc, callback)
    local ModuleFrame = Instance.new("Frame")
    ModuleFrame.Parent = ScrollContainer
    ModuleFrame.BackgroundColor3 = Color3.fromRGB(22, 22, 32)
    ModuleFrame.Size = UDim2.new(1, 0, 0, 65)
    
    local MFCorner = Instance.new("UICorner")
    MFCorner.CornerRadius = UDim.new(0, 8)
    MFCorner.Parent = ModuleFrame
    
    local MTitle = Instance.new("TextLabel")
    MTitle.Parent = ModuleFrame
    MTitle.BackgroundTransparency = 1
    MTitle.Position = UDim2.new(0, 12, 0, 6)
    MTitle.Size = UDim2.new(1, -24, 0, 18)
    MTitle.Font = Enum.Font.GothamBold
    MTitle.Text = name
    MTitle.TextColor3 = Color3.fromRGB(240, 240, 255)
    MTitle.TextSize = 12
    MTitle.TextXAlignment = Enum.TextXAlignment.Left
    
    local MDesc = Instance.new("TextLabel")
    MDesc.Parent = ModuleFrame
    MDesc.BackgroundTransparency = 1
    MDesc.Position = UDim2.new(0, 12, 0, 24)
    MDesc.Size = UDim2.new(1, -100, 0, 16)
    MDesc.Font = Enum.Font.Gotham
    MDesc.Text = desc
    MDesc.TextColor3 = Color3.fromRGB(150, 150, 170)
    MDesc.TextSize = 9
    MDesc.TextXAlignment = Enum.TextXAlignment.Left
    
    local ActionBtn = Instance.new("TextButton")
    ActionBtn.Parent = ModuleFrame
    ActionBtn.BackgroundColor3 = Color3.fromRGB(0, 165, 255)
    ActionBtn.Position = UDim2.new(1, -85, 0, 16)
    ActionBtn.Size = UDim2.new(0, 75, 0, 32)
    ActionBtn.Font = Enum.Font.GothamBold
    ActionBtn.Text = "OFF"
    ActionBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    ActionBtn.TextSize = 11
    
    local ABCorner = Instance.new("UICorner")
    ABCorner.CornerRadius = UDim.new(0, 6)
    ABCorner.Parent = ActionBtn
    
    local active = false
    ActionBtn.MouseButton1Click:Connect(function()
        active = not active
        if active then
            ActionBtn.Text = "ON"
            ActionBtn.BackgroundColor3 = Color3.fromRGB(60, 210, 110)
        else
            ActionBtn.Text = "OFF"
            ActionBtn.BackgroundColor3 = Color3.fromRGB(0, 165, 255)
        end
        callback(active)
    end)
end

CreateControlModule("Auto-Steal & Chicken Biom", "Guía, Instant Steal y transporte al bioma", function(state)
    task.spawn(function()
        while state and ScreenGui.Parent do
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    for _, egg in pairs(Workspace:GetDescendants()) do
                        if egg:IsA("Model") and egg.Name:lower():find("egg") and state then
                            local targetPart = egg.PrimaryPart or egg:FindFirstChildWhichIsA("BasePart")
                            if targetPart then
                                char.HumanoidRootPart.CFrame = CFrame.new(char.HumanoidRootPart.Position:Lerp(targetPart.Position, 0.1))
                                
                                for _, prompt in pairs(egg:GetDescendants()) do
                                    if prompt:IsA("ProximityPrompt") then
                                        fireproximityprompt(prompt)
                                    end
                                end
                                
                                task.wait(0.5)
                                
                                local safeZone = Workspace:FindFirstChild("ChickenBiome") or Workspace:FindFirstChild("SafeZone")
                                if safeZone then
                                    char.HumanoidRootPart.CFrame = safeZone.CFrame
                                end
                            end
                        end
                    end
                end
            end)
            task.wait(0.3)
        end
    end)
end)

CreateControlModule("Protección & Botón 'Steal'", "Anti-Hit, Anti-Ragdoll y frenado de robo", function(state)
    task.spawn(function()
        while state and ScreenGui.Parent do
            pcall(function()
                local char = LocalPlayer.Character
                if char then
                    local humanoid = char:FindFirstChild("Humanoid")
                    if humanoid then
                        for _, stateType in pairs(Enum.HumanoidStateType:GetEnumItems()) do
                            if stateType ~= Enum.HumanoidStateType.Dead and stateType ~= Enum.HumanoidStateType.Running then
                                humanoid:SetStateEnabled(stateType, false)
                            end
                        end
                    end
                end
            end)
            task.wait(0.2)
        end
    end)
end)

local EmergencyBtn = Instance.new("TextButton")
EmergencyBtn.Parent = ScrollContainer
